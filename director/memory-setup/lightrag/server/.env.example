# ╔══════════════════════════════════════════════════════════════╗
# ║            LightRAG — Переменные окружения                  ║
# ║                                                              ║
# ║  Скопируй этот файл:  cp .env.example .env                  ║
# ║  Заполни все значения помеченные <...>                       ║
# ╚══════════════════════════════════════════════════════════════╝

# ─── LLM (OpenAI-совместимый API) ─────────────────────────────
# Любой провайдер с OpenAI-совместимым API:
# - Polza.ai: https://polza.ai/api/v1
# - OpenRouter: https://openrouter.ai/api/v1
# - OpenAI напрямую: https://api.openai.com/v1
LLM_BINDING=openai
LLM_BINDING_HOST=<URL провайдера, например https://polza.ai/api/v1>
LLM_BINDING_API_KEY=<твой API ключ>

# Модель для извлечения сущностей из текста
# Рекомендуемая: google/gemini-2.5-flash-lite (дёшево и быстро)
LLM_MODEL=google/gemini-2.5-flash-lite
LLM_MAX_TOKEN_SIZE=32768

# ─── Embeddings ───────────────────────────────────────────────
# Тот же провайдер и ключ что и для LLM
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=<тот же URL провайдера>
EMBEDDING_BINDING_API_KEY=<тот же API ключ>

# Модель эмбеддингов
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_MAX_TOKEN_SIZE=8192

# ─── PostgreSQL ───────────────────────────────────────────────
# ВАЖНО: POSTGRES_USER/DATABASE зафиксированы образом gzdaniel/postgres-for-rag:16.6 — не меняй их.
# POSTGRES_PASSWORD — НЕ оставляй "rag". Сгенерируй: openssl rand -hex 20
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=<сгенерируй: openssl rand -hex 20 — НЕ "rag">
# ВАЖНО: переменная называется POSTGRES_DATABASE (не POSTGRES_DB!)
POSTGRES_DATABASE=rag

# Все 4 хранилища — PostgreSQL
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
LIGHTRAG_GRAPH_STORAGE=PGGraphStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage

# ─── Авторизация ──────────────────────────────────────────────
# API ключ (передаётся через заголовок X-API-Key)
# Сгенерируй: openssl rand -hex 32
LIGHTRAG_API_KEY=<сгенерируй: openssl rand -hex 32>

# Аккаунты для веб-интерфейса (формат: user:password)
AUTH_ACCOUNTS=admin:<придумай пароль>

# Секрет для JWT токенов (ОБЯЗАТЕЛЬНО сменить!)
# Сгенерируй: openssl rand -hex 32
TOKEN_SECRET=<сгенерируй: openssl rand -hex 32>

# Время жизни токена (часы)
TOKEN_EXPIRE_HOURS=48

# ─── Безопасность ─────────────────────────────────────────────
# Разрешённые домены для CORS (только твой домен)
CORS_ORIGINS=https://<твой-домен>

# Пути без авторизации (только health check)
WHITELIST_PATHS=/health

# ─── Сервер ───────────────────────────────────────────────────
PORT=9621
HOST=0.0.0.0
LOG_LEVEL=INFO
TIMEOUT=150
